# <%= object.type %> <%= object.path %>

<%= erb(:metadata).strip %>
<%- lines = annotation_lines(object) -%>
<%- unless lines.empty? -%>

<%= lines.join("\n") %>
<%- end -%>
<%- unless object.docstring.empty? -%>

<%= markdownify(object.docstring) %>
<%- end -%>
<%- examples = examples_block(object) -%>
<%- if examples -%>

<%= examples %>
<%- end -%>
<%- trailing = trailing_annotation_lines(object) -%>
<%- unless trailing.empty? -%>

<%= trailing.join("\n") %>
<%- end -%>
<%- if any_members? -%>

<%= erb(:member_summary).strip %>
<%- end -%>
<%- if any_member_sections? -%>

<%= erb(:member_sections).strip %>
<%- end -%>
