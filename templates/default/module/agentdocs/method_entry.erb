  # the Returns section in the tail, which re-tests +overloads.size < 2+ to
  # know whether +primary+ (as opposed to per-overload Returns already
  # rendered above) applies.
-%>
<%- primary = overloads.size < 2 ? overloads.first : nil -%>
<%- if overloads.size >= 2 -%>
